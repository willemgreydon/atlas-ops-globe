node_modules
.next
.env
.env.local
.DS_Store
coverage
*.log

# Playwright
/test-results
/playwright-report
/blob-report

# Next.js auto-generated AI agent files
/AGENTS.md
/CLAUDE.md

# --- Intelligence Vault: generated / high-volume data (not committed) ---
# SQLite database + WAL/SHM
/data/*.db
/data/*.db-shm
/data/*.db-wal
# libsql embedded replica (Turso) + its sidecar files
/data/replica.db*
# EXCEPTION: the read-only vault snapshot IS committed — it's the fallback the
# read path serves when Turso's free read quota is blocked (see lib/intel/db.ts
# getReadDb + next.config outputFileTracingIncludes). Refresh via scripts/build-vault-snapshot.
!/data/vault-snapshot.db
# Raw provider snapshots + generated artifacts that churn every run
/intelligence/**/raw/
/intelligence/**/snapshots/
/intelligence/_core/manifests/status.json
/intelligence/_core/indexes/
# Committed on purpose (small, stable): schemas, ontology.json, sources/registry.json, READMEs, manifest.json

# TS incremental build info
tsconfig.tsbuildinfo
.vercel
.env*
