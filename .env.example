# All secrets stay server-side. Only NEXT_PUBLIC_* values reach the browser.
# The app boots and shows live data WITHOUT any of these (anonymous tiers).

# --- Globe rendering (optional) ---
# Cesium ion token enables premium terrain/imagery. Without it the globe uses
# OpenStreetMap tiles and the default ellipsoid. This is the ONLY public var.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# --- Aviation ---
# OpenSky works anonymously (low quota). Client credentials raise the limit.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Planned providers (controls appear disabled until configured) ---
MARINETRAFFIC_API_KEY=
AISSTREAM_API_KEY=
ACLED_CLIENT_ID=
ACLED_CLIENT_SECRET=
RELIEFWEB_APPNAME=atlas-ops-globe
NEWSAPI_KEY=
EVENTREGISTRY_API_KEY=
NVD_API_KEY=
