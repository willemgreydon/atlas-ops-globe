# =============================================================================
# Atlas Ops Globe — environment template
# Copy to .env.local and fill in credentials. All secrets stay server-side;
# only NEXT_PUBLIC_* values are exposed to the browser.
# The app + intelligence vault run on public/zero-key sources WITHOUT any of
# these (OpenSky/USGS/EONET/GDELT/World Bank/CISA KEV/NVD/CelesTrak/Natural Earth).
# =============================================================================

# --- Globe rendering (optional; only NEXT_PUBLIC_ var) ------------------------
# Cesium ion token unlocks the "Surface" control in Globe settings: World Terrain
# (real elevation relief) and Google Photorealistic 3D Tiles (textured 3D cities).
# Get a free token at https://ion.cesium.com/tokens. Without it the globe uses
# OpenStreetMap tiles + the default ellipsoid (everything else works unchanged).
# Note: photorealistic tiles are ion-hosted and Google usage is billed.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# --- Aviation: OpenSky (works anonymously; credentials raise the quota) -------
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Maritime / AIS (credential-required; adapters wired, OFFLINE without key)-
# MarineTraffic AIS Data API (Kpler): 40-char hex key, used in the URL path.
MARINETRAFFIC_API_KEY=
# AISstream (websocket) API key.
AISSTREAM_API_KEY=

# --- Conflict: ACLED (OAuth password grant — your myACLED email + password) --
# Register free at https://acleddata.com/register/. client_id is hard-coded.
ACLED_USERNAME=
ACLED_PASSWORD=

# --- Humanitarian: ReliefWeb (no key; requires an appname identifier) ---------
RELIEFWEB_APPNAME=atlas-ops-globe

# --- Cyber: NVD (optional API key raises the rate limit) ----------------------
NVD_API_KEY=

# --- News (optional commercial feeds; GDELT needs no key) ---------------------
NEWSAPI_KEY=
EVENTREGISTRY_API_KEY=

# --- Space (optional; CelesTrak needs no key) --------------------------------
SPACE_TRACK_USERNAME=
SPACE_TRACK_PASSWORD=

# --- Markets (all credential-required; not yet wired) ------------------------
POLYGON_API_KEY=
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=

# --- Environment/space extras (optional) -------------------------------------
NASA_API_KEY=

# --- Intelligence vault (optional overrides) ---------------------------------
# Override the SQLite path (default: ./data/intelligence.db; ":memory:" for tests)
INTEL_DB_PATH=

# --- Turso (hosted vault DB for serverless/Vercel) ---------------------------
# When set, the app runs as a libsql embedded replica of this primary: reads hit
# a fast local copy (in /tmp on Vercel), the sync CLI writes to the primary.
# Leave BOTH blank for a plain local file DB (dev). Get these from `turso db show`
# and `turso db tokens create`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Where the embedded replica file lives (default: /tmp/atlas-intel.db on Vercel).
INTEL_REPLICA_PATH=
